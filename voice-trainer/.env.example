# Supabase connection for the SvelteKit client.
# These are PUBLIC values (safe to ship to the browser) — security comes from
# Row-Level Security, not from hiding the anon key.
#
# Local development: run `npx supabase start` and copy the printed
# "API URL" and "anon key" here. The defaults below are the standard local
# values and usually match.
#
# Production: paste your hosted project's URL + anon key.

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
